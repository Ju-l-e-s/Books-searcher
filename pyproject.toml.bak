[project]
name = "bookshelf-sniper"
requires-python = ">=3.10"

[tool.pytest.ini_options]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
version = "0.1.0"
description = "Transformer une photo de tranches de livres en un tableau de prix de rachat."
authors = [{ name = "Jules", email = "jules@example.com" }]
dependencies = [
    "fastapi>=0.100.0",
    "uvicorn>=0.22.0",
    "pydantic>=2.0.0",
    "python-multipart>=0.0.6",
    "ultralytics>=8.0.0",
    "opencv-python-headless>=4.8.0",
    "easyocr>=1.7.0",
    "rapidfuzz>=3.1.0",
    "httpx>=0.24.0",
    "playwright>=1.35.0",
    "jinja2>=3.1.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0.0",
    "pytest-asyncio>=0.21.0",
]

[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"
